# IPv4 address of the computer running the Python GUI.
client_host=127.0.0.1

# Camera and remote storage settings.
camera_device=/dev/video0
media_directory=media
width=1280
height=720
fps=30
jpeg_quality=90

# UDP control, heartbeat, and live-video ports.
command_port=7000
heartbeat_port=7001
stream_port=5000
heartbeat_interval_ms=1000

